# Configuration de l'environnement Sekou
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
USE_SEARCH=false

ALLOWED_ORIGIN=http://localhost:5500
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Mail ('log' ou 'brevo')
MAIL_DRIVER=log
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Sekou

# Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=assistant_ia
DB_USER=postgres
DB_PASS=your_password_here
